---
import SiteLayout from '../layouts/SiteLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import genres from '../data/explore-genres.json';
import eras from '../data/explore-eras.json';
import relations from '../data/explore-relations.json';
import relationNotes from '../data/explore-relation-notes.json';
import { eraReading, genreReading } from '../data/explore-reading';
import { getArchiveArticles } from '../data/archive-sources';
import { families, additionalFirstEras, firstEraOverrides } from '../data/explore-structure';

const names = new Map(genres.map((genre) => [genre.id, genre.name]));
const genreById = new Map(genres.map((genre) => [genre.id, genre]));
const notes = relationNotes as Record<string, string>;
const firstEraByGenre = new Map<string, string>();
eras.forEach((era) => era.genres.forEach((id) => {
  if (!firstEraByGenre.has(id)) firstEraByGenre.set(id, era.id);
}));
Object.entries(additionalFirstEras).forEach(([id, eraId]) => firstEraByGenre.set(id, eraId));
Object.entries(firstEraOverrides).forEach(([id, eraId]) => firstEraByGenre.set(id, eraId));
const groupedIds = families.flatMap((family) => family.groups.flatMap((group) => group.genres.map((id) => ({ id, family: family.id }))));
const eraIds = new Set(eras.map((era) => era.id));
const groupErrors = groupedIds.filter(({ id, family }) => genreById.get(id)?.family !== family).map(({ id }) => id);
const missingOrRepeated = genres.filter((genre) => groupedIds.filter(({ id }) => id === genre.id).length !== 1).map((genre) => genre.id);
const unplaced = genres.filter((genre) => !eraIds.has(firstEraByGenre.get(genre.id) ?? '')).map((genre) => genre.id);
if (groupErrors.length || missingOrRepeated.length || unplaced.length || groupedIds.length !== genres.length) {
  throw new Error(`探索页数据不完整：分组不匹配 ${groupErrors.join(', ')}；遗漏或重复 ${missingOrRepeated.join(', ')}；时间未定位 ${unplaced.join(', ')}`);
}
const timelineGenres = new Map(eras.map((era) => [era.id, genres.filter((genre) => firstEraByGenre.get(genre.id) === era.id)]));
const familyCounts = new Map(families.map((family) => [family.id, family.groups.reduce((count, group) => count + group.genres.length, 0)]));
const kindLabels: Record<string, string> = {
  root: '根源传统',
  adjacent: '相邻传统',
  genre: '流派',
  scene: '场景／运动',
  umbrella: '伞形标签',
  method: '方法／修饰语',
};
const relationLabels: Record<string, string> = {
  derived_from: '衍生',
  fusion_of: '融合',
  influenced_by: '影响',
  scene_successor: '场景承接',
  commercialized_as: '市场化',
  revival_of: '复兴',
  parallel_with: '并行',
};
---

<SiteLayout
  title="摇滚时间线与流派分类"
  description="沿时间线查看摇滚流派的出现与分化，再按分类理解每种声音的特点与关系。"
  page="explore"
>
  <div class="explore-page">
    <header class="page-intro">
      <div>
        <p class="eyebrow">ROCK / TIME & GENRES</p>
        <h1>探索</h1>
      </div>
      <p>时间如何推进，声音如何分支。</p>
    </header>

    <nav class="section-nav" aria-label="探索页导航">
      <a href="#timeline">时间线 <span>{eras.length} 个时期</span></a>
      <a href="#taxonomy">流派分类 <span>{genres.length} 个条目</span></a>
    </nav>

    <section class="timeline section-block" id="timeline" aria-labelledby="timeline-title">
      <div class="section-title">
        <p class="eyebrow">01 / CHRONOLOGY</p>
        <h2 id="timeline-title">时间线</h2>
        <p>每个条目只放在大致形成的阶段；不是它的终止年份。</p>
      </div>

      <div class="timeline-head" aria-hidden="true">
        <span>形成时期</span>
        {families.map((family) => <span>{family.title}</span>)}
      </div>
      <ol class="era-list">
        {eras.map((era, index) => (
          <li id={`era-${era.id}`}>
            <div class="era-marker">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <time>{era.period}</time>
              <h3>{era.title}</h3>
            </div>
            {families.map((family) => {
              const placed = timelineGenres.get(era.id)?.filter((genre) => genre.family === family.id) ?? [];
              return (
                <div class="era-lane" data-empty={placed.length === 0} aria-label={`${family.title}，${placed.length} 个条目`}>
                  <span class="era-lane-label">{family.title}</span>
                  {placed.map((genre) => (
                    <a href={`#genre-${genre.id}`} data-open-genre={genre.id}>
                      <span class="era-node-dot" aria-hidden="true"></span>{genre.name}
                    </a>
                  ))}
                  {placed.length === 0 && <span class="era-empty" aria-hidden="true">—</span>}
                </div>
              );
            })}
            <details class="era-reading">
              <summary><span>这一时期：{era.summary}</span><span aria-hidden="true">+</span></summary>
              <div class="era-reading-body">
                <div class="era-story">
                  {eraReading[era.id].story.map((paragraph) => <p>{paragraph}</p>)}
                </div>
                <div class="era-reading-sources">
                  <div>
                    <h4>发展节点</h4>
                    <ol class="event-list">
                      {eraReading[era.id].events.map((event) => (
                        <li><time>{event.when}</time><strong>{event.title}</strong><p>{event.note}</p></li>
                      ))}
                    </ol>
                  </div>
                  <div>
                    <h4>代表录音</h4>
                    <ol class="listening-list">
                      {eraReading[era.id].listening.map((album) => (
                        <li><time>{album.year}</time><div><strong>{album.title}</strong><span>{album.artist}</span><p>{album.note}</p></div></li>
                      ))}
                    </ol>
                  </div>
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>

    <section class="taxonomy section-block" id="taxonomy" aria-labelledby="taxonomy-title">
      <div class="section-title">
        <p class="eyebrow">02 / GENRE CLASSIFICATION</p>
        <h2 id="taxonomy-title">流派分类</h2>
        <p>按声音与历史脉络分组；交叉影响见各条目的关系。</p>
      </div>

      <nav class="family-nav" aria-label="流派大类">
        {families.map((family) => (
          <a href={`#family-${family.id}`}><span>{family.number}</span>{family.title}<small>{familyCounts.get(family.id)}</small></a>
        ))}
      </nav>

      <div class="index-tools">
        <label for="genre-search">查找名称或特征</label>
        <input id="genre-search" type="search" placeholder="例如：后朋克 / Shoegaze / 1990s" autocomplete="off" data-genre-search />
        <span data-result-count>共 {genres.length} 条</span>
      </div>

      <p class="no-results" data-no-results hidden>没有匹配的条目。试试中文名、英文名或年代。</p>

      {families.map((family) => (
        <section class="family" id={`family-${family.id}`} data-family>
          <header class="family-heading">
            <span>{family.number}</span>
            <h3>{family.title}</h3>
            <span>{familyCounts.get(family.id)} 条</span>
          </header>

          {family.groups.map((group) => (
          <div class="genre-group" id={`group-${group.id}`} data-group>
            <header class="genre-group-heading">
              <h4>{group.title}</h4>
              <p>{group.note}</p>
              <span>{group.genres.length} 条</span>
            </header>
            <div class="genre-list">
            {group.genres.map((id) => {
              const genre = genreById.get(id)!;
              const incoming = relations.filter((relation) => relation.to === genre.id && relation.from !== genre.id);
              const outgoing = relations.filter((relation) => relation.from === genre.id && relation.to !== genre.id);
              const reading = genreReading[genre.id];
              const searchValue = `${genre.name} ${genre.period} ${genre.definition} ${kindLabels[genre.kind] ?? ''} ${reading?.context ?? ''} ${reading?.traits.join(' ') ?? ''} ${reading?.artists.join(' ') ?? ''}`.toLocaleLowerCase();
              if (!reading && incoming.length === 0 && outgoing.length === 0) return (
                <div class="genre-row genre-row-static" id={`genre-${genre.id}`} data-genre={genre.id} data-search-value={searchValue}>
                  <div class="genre-static-content">
                    <span class="genre-name">{genre.name}</span>
                    <span class="genre-summary-definition">{genre.definition}</span>
                    <span class="genre-period">{genre.period} · {kindLabels[genre.kind] ?? '流派'}</span>
                  </div>
                </div>
              );
              return (
                <details
                  class="genre-row"
                  id={`genre-${genre.id}`}
                  data-genre={genre.id}
                  data-search-value={searchValue}
                >
                  <summary>
                    <span class="genre-name">{genre.name}</span>
                    <span class="genre-summary-definition">{genre.definition}</span>
                    <span class="genre-period">{genre.period} · {kindLabels[genre.kind] ?? '流派'}</span>
                    <span class="genre-expand" aria-hidden="true">+</span>
                  </summary>
                  <div class="genre-detail">
                    {reading && (
                      <div class="genre-reading">
                        <p class="genre-context">{reading.context}</p>
                        <div class="genre-reading-grid">
                          <div><h4>听觉线索</h4><ul>{reading.traits.map((trait) => <li>{trait}</li>)}</ul></div>
                          {reading.artists.length > 0 && <div><h4>代表人物</h4><p>{reading.artists.join(' · ')}</p></div>}
                        </div>
                        {reading.record && (
                          <div class="genre-record">
                            <span>从一张唱片进入</span>
                            <div><strong>{reading.record.title}</strong><small>{reading.record.artist} · {reading.record.year}</small><p>{reading.record.note}</p></div>
                          </div>
                        )}
                        <p class="genre-boundary"><span>边界</span>{reading.boundary}</p>
                        {reading.sourceArticles && (
                          <div class="genre-sources">
                            <span>延伸阅读</span>
                            <ul>{getArchiveArticles(reading.sourceArticles).map((article) => (
                              <li><a href={article.source_url} target="_blank" rel="noreferrer">{article.title} <ArrowIcon /></a></li>
                            ))}</ul>
                          </div>
                        )}
                      </div>
                    )}
                    {(incoming.length > 0 || outgoing.length > 0) && (
                      <div class="genre-relations">
                        {incoming.length > 0 && (
                          <div>
                            <span>来源与影响</span>
                            <ul>
                              {incoming.map((relation) => (
                                <li><a href={`#genre-${relation.from}`} data-open-genre={relation.from}>{names.get(relation.from)}</a><small>{relationLabels[relation.type]}</small><p>{notes[`${relation.from}|${relation.to}|${relation.type}`]}</p></li>
                              ))}
                            </ul>
                          </div>
                        )}
                        {outgoing.length > 0 && (
                          <div>
                            <span>后续与连接</span>
                            <ul>
                              {outgoing.map((relation) => (
                                <li><a href={`#genre-${relation.to}`} data-open-genre={relation.to}>{names.get(relation.to)}</a><small>{relationLabels[relation.type]}</small><p>{notes[`${relation.from}|${relation.to}|${relation.type}`]}</p></li>
                              ))}
                            </ul>
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                </details>
              );
            })}
            </div>
          </div>
          ))}
        </section>
      ))}
    </section>

    <aside class="source-note" aria-label="资料与边界">
      <p>分组用于检索，不是唯一父系；时间位置指大致形成阶段，不代表起点或终点精确到年。关系只展示资料母稿中较有依据的连结。</p>
      <p>资料基础：<a href="https://rockhall.com/exhibitions/roots-of-rock/" target="_blank" rel="noreferrer">Rock Hall</a>、<a href="https://nmaahc.si.edu/explore/stories/celebrating-black-music-month" target="_blank" rel="noreferrer">Smithsonian</a>、<a href="https://lcweb2.loc.gov/static/programs/national-recording-preservation-board/documents/Velvet-Underground-and-Nico_Levy.pdf" target="_blank" rel="noreferrer">Library of Congress</a> 及项目整理资料。</p>
    </aside>
  </div>
</SiteLayout>

<script>
  const search = document.querySelector<HTMLInputElement>('[data-genre-search]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-genre]'));
  const families = Array.from(document.querySelectorAll<HTMLElement>('[data-family]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-group]'));
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');

  const applySearch = () => {
    const query = search?.value.trim().toLocaleLowerCase() ?? '';
    let matches = 0;
    rows.forEach((row) => {
      const visible = !query || row.dataset.searchValue?.includes(query);
      row.hidden = !visible;
      if (visible) matches += 1;
    });
    groups.forEach((group) => { group.hidden = !group.querySelector('[data-genre]:not([hidden])'); });
    families.forEach((family) => { family.hidden = !family.querySelector('[data-group]:not([hidden])'); });
    if (resultCount) resultCount.textContent = query ? `找到 ${matches} 条` : `共 ${rows.length} 条`;
    if (noResults) noResults.hidden = matches !== 0;
  };

  const openGenre = (id: string, scroll = true, instant = false) => {
    const row = document.getElementById(`genre-${id}`);
    if (!row) return;
    if (search) search.value = '';
    applySearch();
    rows.forEach((entry) => entry.classList.toggle('is-selected', entry === row));
    if (row instanceof HTMLDetailsElement) row.open = true;
    if (scroll) requestAnimationFrame(() => {
      const farAway = Math.abs(row.getBoundingClientRect().top) > window.innerHeight * 2;
      row.scrollIntoView({ behavior: instant || farAway ? 'instant' : 'smooth', block: 'start' });
    });
  };

  search?.addEventListener('input', applySearch);
  search?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && search.value) {
      search.value = '';
      applySearch();
    }
  });

  document.querySelectorAll<HTMLAnchorElement>('.family-nav a').forEach((link) => {
    link.addEventListener('click', () => {
      if (search?.value) {
        search.value = '';
        applySearch();
      }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-open-genre]').forEach((link) => {
    link.addEventListener('click', (event) => {
      const id = link.dataset.openGenre;
      if (!id) return;
      event.preventDefault();
      openGenre(id);
      const url = new URL(window.location.href);
      url.searchParams.set('genre', id);
      history.pushState({ genre: id }, '', url);
    });
  });

  rows.forEach((row) => {
    if (!(row instanceof HTMLDetailsElement)) return;
    row.addEventListener('toggle', () => {
      if (!row.open) return;
      const id = row.dataset.genre;
      if (!id) return;
      const url = new URL(window.location.href);
      url.searchParams.set('genre', id);
      history.replaceState({ genre: id }, '', url);
    });
  });

  window.addEventListener('popstate', () => {
    const id = new URL(window.location.href).searchParams.get('genre');
    if (id) openGenre(id, true, true);
    else rows.forEach((row) => { if (row instanceof HTMLDetailsElement) row.open = false; });
  });

  const initial = new URL(window.location.href).searchParams.get('genre')
    ?? window.location.hash.replace(/^#genre-/, '');
  if (initial) openGenre(initial, true, true);
</script>

<style>
  .explore-page { max-width: 1600px; margin: 0 auto; }
  .page-intro { min-height: 17rem; padding: 7rem 3.5% 2.5rem; display: flex; align-items: end; justify-content: space-between; gap: 2rem; }
  .page-intro h1 { margin: 1.5rem 0 0; font-size: clamp(5rem, 11vw, 10rem); line-height: 0.85; letter-spacing: -0.09em; }
  .page-intro > p { max-width: 18rem; margin: 0; font-size: 0.88rem; line-height: 1.7; }
  .section-nav { position: sticky; z-index: 20; top: 4.25rem; display: flex; gap: 2rem; padding: 0.9rem 3.5%; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); background: var(--paper); }
  .section-nav a { display: flex; gap: 0.8rem; align-items: baseline; text-decoration: none; font-size: 0.75rem; font-weight: 600; }
  .section-nav a span { color: var(--muted); font-family: var(--mono); font-size: 0.62rem; font-weight: 400; }
  .section-nav a:hover, .era-lane a:hover, .genre-relations a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .section-block { padding: 4rem 3.5% 7rem; scroll-margin-top: 7.5rem; }
  .section-title { display: grid; grid-template-columns: minmax(0, 1fr) 17rem; align-items: end; margin-bottom: 3rem; }
  .section-title .eyebrow { grid-column: 1 / -1; }
  .section-title h2 { margin: 0.7rem 0 0; font-size: clamp(3.5rem, 7vw, 6rem); line-height: 0.9; letter-spacing: -0.08em; }
  .section-title > p:last-child { max-width: 17rem; margin: 0; color: var(--muted); font-size: 0.78rem; line-height: 1.6; }
  .timeline-head, .era-list > li { display: grid; grid-template-columns: minmax(11rem, 23%) repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .timeline-head { padding: 0.8rem 0; border-top: 1px solid var(--ink); color: var(--muted); font-family: var(--mono); font-size: 0.6rem; }
  .timeline-head span:not(:first-child) { padding-left: 0.75rem; border-left: 1px solid var(--line); }
  .era-list { margin: 0; padding: 0; list-style: none; }
  .era-list > li { padding: 1.55rem 0 0; border-top: 1px solid var(--line); scroll-margin-top: 8.5rem; }
  .era-marker { display: grid; align-content: start; gap: 0.55rem; }
  .era-marker > span { font-family: var(--mono); font-size: 0.62rem; color: var(--muted); }
  .era-marker time { font-family: var(--serif); font-size: clamp(1.35rem, 2vw, 2rem); font-style: italic; letter-spacing: -0.06em; }
  .era-marker h3 { max-width: 13rem; margin: 0; font-size: 0.9rem; line-height: 1.3; }
  .era-lane { display: grid; align-content: start; gap: 0.35rem; min-height: 5rem; padding-left: 0.75rem; border-left: 1px solid var(--line); }
  .era-lane-label { display: none; }
  .era-lane a { display: flex; align-items: baseline; gap: 0.45rem; width: fit-content; font-size: 0.73rem; line-height: 1.4; text-decoration: none; }
  .era-node-dot { flex: none; width: 0.3rem; height: 0.3rem; border: 1px solid var(--ink); border-radius: 50%; }
  .era-empty { color: var(--line); font-family: var(--mono); font-size: 0.7rem; }
  .era-reading { grid-column: 1 / -1; margin-top: 0.5rem; border-top: 1px solid var(--line); }
  .era-reading summary { display: flex; justify-content: space-between; gap: 1rem; padding: 0.9rem 0; color: var(--muted); font-size: 0.72rem; line-height: 1.55; cursor: pointer; list-style: none; }
  .era-reading summary::-webkit-details-marker { display: none; }
  .era-reading summary span:last-child { font-size: 0.9rem; font-weight: 400; transition: transform 180ms ease; }
  .era-reading[open] summary span:last-child { transform: rotate(45deg); }
  .era-reading-body { padding: 0.9rem 0 1.2rem; }
  .era-story { display: grid; gap: 0.9rem; max-width: 48rem; }
  .era-story p { margin: 0; font-size: 0.83rem; line-height: 1.85; }
  .era-reading-sources { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 2.5rem; margin-top: 2rem; }
  .era-reading-sources h4, .genre-reading h4 { margin: 0 0 0.8rem; color: var(--muted); font-family: var(--mono); font-size: 0.62rem; font-weight: 500; }
  .event-list, .listening-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .event-list li, .listening-list li { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 0.2rem 0.8rem; padding: 0.75rem 0; border-bottom: 1px solid var(--line); }
  .event-list time, .listening-list time { color: var(--muted); font-family: var(--mono); font-size: 0.6rem; line-height: 1.5; }
  .event-list strong, .listening-list strong { font-size: 0.74rem; font-weight: 600; line-height: 1.45; }
  .event-list p { grid-column: 2; }
  .event-list p, .listening-list p { margin: 0; color: var(--muted); font-size: 0.69rem; line-height: 1.55; }
  .listening-list li > div { display: grid; gap: 0.16rem; }
  .listening-list span { font-size: 0.68rem; }
  .taxonomy { border-top: 1px solid var(--ink); }
  .family-nav { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin: 0 0 3rem; }
  .family-nav a { display: grid; gap: 0.5rem; padding: 0.8rem 0; border-top: 1px solid var(--ink); font-size: 0.85rem; font-weight: 600; text-decoration: none; }
  .family-nav a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .family-nav span, .family-nav small { color: var(--muted); font-family: var(--mono); font-size: 0.61rem; font-weight: 400; }
  .index-tools { display: grid; grid-template-columns: minmax(12rem, 15rem) minmax(0, 1fr) auto; align-items: center; gap: 1.5rem; padding: 0.8rem 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .index-tools label, .index-tools > span { font-family: var(--mono); font-size: 0.65rem; }
  .index-tools > span { color: var(--muted); white-space: nowrap; }
  .index-tools input { width: 100%; padding: 0.45rem 0; border: 0; border-radius: 0; outline: 0; background: transparent; color: var(--ink); font-size: 0.83rem; }
  .index-tools input:focus-visible { outline: 2px solid var(--signal); outline-offset: 4px; }
  .index-tools input::placeholder { color: var(--muted); }
  .family { padding: 4rem 0 2rem; scroll-margin-top: 8rem; }
  .family[hidden], .genre-group[hidden], .genre-row[hidden], .no-results[hidden] { display: none; }
  .family-heading { display: flex; align-items: baseline; gap: 1rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--ink); }
  .family-heading > span { font-family: var(--mono); font-size: 0.62rem; }
