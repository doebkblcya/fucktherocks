---
import '../styles/global.css';
import ArrowIcon from '../components/ArrowIcon.astro';

interface Props {
  title?: string;
  description?: string;
  page?: 'home' | 'explore' | 'error';
}

const {
  title = 'FuckTheRocks',
  description = '用时间化关系网络探索摇滚的发展路线、流派与代表专辑。',
  page = 'home',
} = Astro.props;

const documentTitle = title === 'FuckTheRocks' ? title : `${title} — FuckTheRocks`;
---

<!doctype html>
<html lang="zh-CN" data-page={page}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f2f1ed" />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳至主要内容</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="FuckTheRocks 首页">FUCKTHEROCKS</a>
      {page !== 'explore' ? (
        <a class="header-link" href="/explore">探索 <ArrowIcon /></a>
      ) : (
        <a class="header-link" href="/">首页 <ArrowIcon /></a>
      )}
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">© {new Date().getFullYear()} FUCKTHEROCKS</footer>
  </body>
</html>
